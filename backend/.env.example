# Copy this file to .env and fill in your values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database: SQLite (default) ----
DB_ENGINE=sqlite
# Keep the database outside the code folder. Default: ../data/shg_system.sqlite3
# SQLITE_PATH=C:\shg-data\shg_system.sqlite3

# ---- Backups ----
# BACKUP_DIR=C:\shg-data\backups
BACKUP_KEEP=30

# ---- Database: MySQL (optional, later) ----
# DB_ENGINE=mysql
# DB_NAME=shg_system
# DB_USER=shg_user
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
